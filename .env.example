# ========================================================
# Sayyad Telegram Bot — Environment Configuration (.env)
# ========================================================

# 1. Telegram Bot Token from @BotFather (Required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Web Admin Dashboard Password (Required for /admin)
ADMIN_PASSWORD=admin123

# 3. Gemini Multi-API-Key Pool (Comma-separated or newline-separated)
# You can paste 20, 30 or more keys here!
GEMINI_API_KEYS=AIzaSy_key1,AIzaSy_key2,AIzaSy_key3

# 4. Optional: Fallback Provider (OpenAI / OpenRouter / DeepSeek)
API_KEY=
API_BASE_URL=https://openrouter.ai/api/v1

# 5. Server Port (Default 8080)
PORT=8080
